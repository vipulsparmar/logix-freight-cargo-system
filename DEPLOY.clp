                 DFTACTGRP(*NO) ACTGRP(*CALLER) REPLACE(*YES)
    CRTBNDRPG  PGM(DEVLIB/MANIFEST) SRCFILE(DEVLIB/QRPGLESRC) +
                 SRCMBR(MANIFEST) DFTACTGRP(*NO) ACTGRP(*CALLER) REPLACE(*YES)
    CRTBNDRPG  PGM(DEVLIB/LOGIN)  SRCFILE(DEVLIB/QRPGLESRC) SRCMBR(LOGIN) +
                 DFTACTGRP(*NO) ACTGRP(*NEW) REPLACE(*YES)

    /* 7. Copy & Compile RUNLOGIN.clp */
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/RUNLOGIN.clp') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QCLSRC.FILE/RUNLOGIN.MBR') +
                 +
   MBROPT(*REPLACE)
    CRTCLPGM   PGM(DEVLIB/RUNLOGIN) SRCFILE(DEVLIB/QCLSRC) +
   SRCMBR(RUNLOGIN) REPLACE(*YES)

    /* 8. Launch Application */
    CALL       PGM(DEVLIB/LOGIN)
ENDPGM

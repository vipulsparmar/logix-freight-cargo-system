    CRTDSPF    FILE(DEVLIB/CUSBKG) SRCFILE(DEVLIB/QDDSSRC) SRCMBR(CUSBKG) +
                 REPLACE(*YES) LVLCHK(*NO)
    CRTPRTF    FILE(DEVLIB/TKTRPT) SRCFILE(DEVLIB/QDDSSRC) SRCMBR(TKTRPT) +
                 REPLACE(*YES) LVLCHK(*NO)
    CRTDSPF    FILE(DEVLIB/TRKSTG) SRCFILE(DEVLIB/QDDSSRC) SRCMBR(TRKSTG) +
                 REPLACE(*YES) LVLCHK(*NO)
    CRTPRTF    FILE(DEVLIB/MANIFEST) SRCFILE(DEVLIB/QDDSSRC) +
                 SRCMBR(MANIFEST) REPLACE(*YES) LVLCHK(*NO)


    /* 5. Copy RPGLE Files from IFS to QRPGLESRC */
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/REGIS.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/REGIS.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/FORGOT.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/FORGOT.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/ADMDSH.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/ADMDSH.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/AIRDSH.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/AIRDSH.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/CUSDSH.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/CUSDSH.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/AIRLST.rpgle') +

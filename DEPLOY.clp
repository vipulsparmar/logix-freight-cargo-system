   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/FORGOT.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/FORGOT.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/ADMDSH.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/ADMDSH.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/AIRDSH.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/AIRDSH.MBR') +

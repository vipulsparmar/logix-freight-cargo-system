   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/MANIFEST.rpgle') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QRPGLESRC.FILE/MANIFEST.MBR') +
                 +
   MBROPT(*REPLACE)

    /* 6. Compile RPGLE Programs */
    CRTBNDRPG  PGM(DEVLIB/REGIS)  SRCFILE(DEVLIB/QRPGLESRC) SRCMBR(REGIS) +
                 DFTACTGRP(*NO) ACTGRP(*CALLER) REPLACE(*YES)
    CRTBNDRPG  PGM(DEVLIB/FORGOT) SRCFILE(DEVLIB/QRPGLESRC) SRCMBR(FORGOT) +
                 DFTACTGRP(*NO) ACTGRP(*CALLER) REPLACE(*YES)
    CRTBNDRPG  PGM(DEVLIB/ADMDSH) SRCFILE(DEVLIB/QRPGLESRC) SRCMBR(ADMDSH) +

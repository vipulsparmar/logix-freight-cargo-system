   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/CUSBKG.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/TKTRPT.prtf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/TKTRPT.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/TRKSTG.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/TRKSTG.MBR') +

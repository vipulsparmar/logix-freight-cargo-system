   MBROPT(*REPLACE)

    /* 4. Compile Display & Printer Files */
    CRTDSPF    FILE(DEVLIB/LOGIN)  SRCFILE(DEVLIB/QDDSSRC) SRCMBR(LOGIN)  +
                 REPLACE(*YES) LVLCHK(*NO)
    CRTDSPF    FILE(DEVLIB/REGIS)  SRCFILE(DEVLIB/QDDSSRC) SRCMBR(REGIS)  +
                 REPLACE(*YES) LVLCHK(*NO)
    CRTDSPF    FILE(DEVLIB/FORGOT) SRCFILE(DEVLIB/QDDSSRC) SRCMBR(FORGOT) +

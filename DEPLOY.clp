/* ------------------------------------------------------------- */
/* Flight Booking System - Automated Deployment & Build from IFS */
/* Target Library: DEVLIB                                        */
/* Remote Path: /home/vipul13051/builds/FLIGHT-BOOKING-PROJECT   */
/* ------------------------------------------------------------- */
PGM
    /* 1. Ensure Library and Source Physical Files exist */
    CRTLIB     LIB(DEVLIB) TEXT('Flight Booking System')
    MONMSG     MSGID(CPF0000)

    CRTSRCPF   FILE(DEVLIB/QDDSSRC) RCDLEN(112)
    MONMSG     MSGID(CPF0000)
    CRTSRCPF   FILE(DEVLIB/QRPGLESRC) RCDLEN(112)
    MONMSG     MSGID(CPF0000)
    CRTSRCPF   FILE(DEVLIB/QCLSRC) RCDLEN(112)
    MONMSG     MSGID(CPF0000)

    /* 2. Execute SQL Database Setup directly from IFS */
    RUNSQLSTM  SRCSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/ +
                 create_tables.sql') +
                 COMMIT(*NONE)
    MONMSG     MSGID(CPF0000)

    /* 3. Copy Display Files from IFS to QDDSSRC */
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/LOGIN.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/LOGIN.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/REGIS.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/REGIS.MBR') +
                 +
   MBROPT(*REPLACE)

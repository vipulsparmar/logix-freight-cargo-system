   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/CUSDSH.MBR') +
                 +
   MBROPT(*REPLACE)
    CPYFRMSTMF +
   FROMSTMF('/home/vipul13051/builds/FLIGHT-BOOKING-PROJECT/AIRLST.dspf') +
                 +
   TOMBR('/QSYS.LIB/DEVLIB.LIB/QDDSSRC.FILE/AIRLST.MBR') +
